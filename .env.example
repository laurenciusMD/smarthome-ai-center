# ============================================
# SMART HOME AI CENTER - Environment Config
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# HOME ASSISTANT CONNECTION
# ============================================
# Your Home Assistant URL (with port if needed)
# Examples: http://192.168.1.100:8123 or https://ha.yourdomain.de
HA_URL=http://homeassistant.local:8123

# Long-Lived Access Token from Home Assistant
# Create at: HA → Profile → Long-Lived Access Tokens → Create Token
HA_TOKEN=your_long_lived_access_token_here

# ============================================
# ANTHROPIC API (Claude)
# ============================================
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ============================================
# INFLUXDB v2 CONFIGURATION
# ============================================
# Admin credentials (only used for initial setup)
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=choose_a_strong_password_here

# Organization and bucket names
INFLUX_ORG=smarthome
INFLUX_BUCKET=homeassistant

# Admin token for API access
# Generate a secure token: openssl rand -hex 32
INFLUX_TOKEN=your_influxdb_token_here

# Data retention period (default 7 days)
# Format: 1h, 24h, 7d, 30d, etc.
INFLUX_RETENTION=7d

# ============================================
# APP SETTINGS
# ============================================
# Timezone
TZ=Europe/Berlin

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================
# Claude model to use (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Max tokens for AI responses
# CLAUDE_MAX_TOKENS=4096

# Cache TTL for HA data in seconds (default: 300 = 5 min)
# CACHE_TTL=300
