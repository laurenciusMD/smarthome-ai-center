# ============================================
# SMART HOME AI CENTER - Environment Variables
# ============================================
# Copy to .env and fill in (optional - UI settings work too!)
# These are OPTIONAL - you can configure everything in the Settings UI

# Home Assistant (optional)
HA_URL=
HA_TOKEN=

# AI Keys (optional)
GOOGLE_AI_KEY=
ANTHROPIC_API_KEY=

# InfluxDB (only needed if using analytics)
INFLUX_TOKEN=
INFLUX_ORG=smarthome
INFLUX_BUCKET=homeassistant

# Timezone
TZ=Europe/Berlin
